# ---------------------------------------------------------------------------
# Copy to .env and edit.   cp .env.example .env
# Windows:                 copy .env.example .env
#
# Nothing here is secret by default. The two API keys are the only fields that
# ever hold a secret, and both are optional.
# ---------------------------------------------------------------------------

# ---- REQUIRED -------------------------------------------------------------

# Postgres. The default matches the db service in docker-compose.yml.
# Supabase / Railway URLs paste in as-is — the app rewrites the scheme.
#   Supabase: Project > Connect > "Session pooler" URI (port 5432)
#   Railway:  Postgres service > Variables > DATABASE_URL
DATABASE_URL=postgresql+asyncpg://lenny:lenny@db:5432/lenny

# Which model answers.  ollama | anthropic | openai | groq
LLM_PROVIDER=ollama

# ---- LOCAL MODEL (used for the demo) --------------------------------------

# Inside Docker this must be host.docker.internal, not localhost.
# Running the API outside Docker? Use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# 8 GB RAM: llama3.2:3b is the sweet spot. Drop to llama3.2:1b if it swaps.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Embeddings are configured separately from chat, because Anthropic has no
# embeddings endpoint.  ollama | openai | hash
# "hash" is a deterministic in-process fallback: no network, weaker ranking.
EMBEDDING_PROVIDER=ollama

# ---- OPTIONAL: cloud providers --------------------------------------------

# Leave blank to disable. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# If the active provider fails, retry once on this one. Blank disables it.
LLM_FALLBACK_PROVIDER=

# ---- OPTIONAL: tuning ------------------------------------------------------

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
# Raise this if a small model on a slow machine keeps timing out.
LLM_TIMEOUT_SECONDS=180

TRANSCRIPTS_DIR=data/transcripts
CHUNK_CHARS=1100
CHUNK_OVERLAP_CHARS=180
RETRIEVAL_TOP_K=6
# Below this hybrid score the assistant says the corpus does not cover it.
RETRIEVAL_MIN_SCORE=0.30
RETRIEVAL_MIN_SCORE_FALLBACK=0.18
MAX_CHUNKS_PER_EPISODE=2

# rules = deterministic only (fastest).  rules+llm = ask the model when unsure.
ROUTER_MODE=rules+llm
SHIP30_TARGET_WORDS=1250
HISTORY_TURNS=8

# Artifact scripts still run inside a cross-origin sandboxed iframe.
ALLOW_ARTIFACT_SCRIPTS=true
ARTIFACT_MAX_BYTES=400000

LOG_LEVEL=INFO
# json for machines, console for reading along during the demo.
LOG_FORMAT=json
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---- OPTIONAL: docker-compose ports ---------------------------------------
API_PORT=8000
WEB_PORT=5173
POSTGRES_PORT=5432
